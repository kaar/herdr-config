#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

show_help() {
    cat <<EOF
Usage: $(basename "$0") [name]

Create a new herdr tab in the current space and start a pi agent in it.
The name is used both as the tab label and the pi session name, so the
agent shows up under that name in herdr's agents panel.

Arguments:
    name          Tab/session name (prompted for if omitted)

Options:
    -h, --help    Show this help message
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi

name="${1:-}"
if [[ -z "$name" ]]; then
    # fzf as a text input: Enter accepts the typed query, Esc (exit 130) cancels
    status=0
    name=$(fzf --print-query --prompt "Agent name: " --no-info --height=100% </dev/null) || status=$?
    [[ "$status" -ge 2 ]] && exit 0
    name=$(head -n1 <<<"$name")
fi
[[ -z "$name" ]] && exit 0

workspace_id="${HERDR_WORKSPACE_ID:-}"
if [[ -z "$workspace_id" ]]; then
    workspace_id=$(herdr workspace list 2>/dev/null |
        jq -r '[.result.workspaces[]? | select(.focused)][0].workspace_id // empty')
fi
[[ -z "$workspace_id" ]] && echo "No herdr workspace found" >&2 && exit 1

created=$(herdr tab create --workspace "$workspace_id" --label "$name" --focus)
pane_id=$(jq -r '.result.root_pane.pane_id // empty' <<<"$created")
[[ -z "$pane_id" ]] && echo "Failed to create tab" >&2 && exit 1

herdr pane run "$pane_id" pi -n "$(printf '%q' "$name")" >/dev/null
